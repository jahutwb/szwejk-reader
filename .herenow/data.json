{
  "draft": true,
  "note": "MVP-0 Site Data sketch. Verify against current here.now docs before publishing.",
  "collections": {
    "word_clicks": {
      "description": "Anonymous token click telemetry for reader interaction analysis.",
      "access": {
        "insert": "public",
        "read": "owner",
        "update": "owner",
        "delete": "owner"
      },
      "fields": {
        "session_id": { "type": "string", "required": true },
        "work_id": { "type": "string", "required": true },
        "volume_id": { "type": "string", "required": true },
        "chapter_id": { "type": "string", "required": true },
        "paragraph_id": { "type": "string", "required": true },
        "token_id": { "type": "string", "required": true },
        "language": { "type": "string", "required": true },
        "candidate_ids": { "type": "array", "items": { "type": "string" } },
        "active_candidate_id": { "type": "string" },
        "viewport": { "type": "string" },
        "font_size": { "type": "number" },
        "created_at_client": { "type": "string", "required": true }
      }
    },
    "correction_events": {
      "description": "Anonymous correction workflow events such as start, expand, shrink, accept, reject, and cancel.",
      "access": {
        "insert": "public",
        "read": "owner",
        "update": "owner",
        "delete": "owner"
      },
      "fields": {
        "session_id": { "type": "string", "required": true },
        "work_id": { "type": "string", "required": true },
        "volume_id": { "type": "string", "required": true },
        "chapter_id": { "type": "string", "required": true },
        "pl_location_id": { "type": "string" },
        "token_id": { "type": "string" },
        "candidate_id": { "type": "string" },
        "event_type": { "type": "string", "required": true },
        "patch_summary": { "type": "object" },
        "created_at_client": { "type": "string", "required": true }
      }
    },
    "override_submissions": {
      "description": "Compact chapter-level user override patches, never full book text.",
      "access": {
        "insert": "public",
        "read": "owner",
        "update": "owner",
        "delete": "owner"
      },
      "fields": {
        "session_id": { "type": "string", "required": true },
        "work_id": { "type": "string" },
        "volume_id": { "type": "string" },
        "chapter_id": { "type": "string" },
        "base_artifact_id": { "type": "string" },
        "override_patch_id": { "type": "string" },
        "pl_location_range": { "type": "object" },
        "operations": { "type": "array" },
        "operation_count": { "type": "number" },
        "client_schema_version": { "type": "string" },
        "created_at_client": { "type": "string", "required": true }
      }
    }
  }
}
